# Admin panel (/admin). Pick a long password (8+ characters).
ADMIN_PASSWORD=change-me-to-a-long-password

# Optional: lets the admin panel publish changes to your live site by committing
# data/campaigns.json to GitHub. Your host (Vercel etc.) then redeploys automatically.
GITHUB_TOKEN=
GITHUB_REPO=your-username/dropshield
GITHUB_BRANCH=main
